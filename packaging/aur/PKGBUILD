# AUR package: bmx
# Maintainer: Your Name <your@email>
# Submit to AUR and users install with: yay -S bmx

pkgname=bmx
pkgver=0.1.3
pkgrel=1
pkgdesc="Command-line tool that installs, builds, and runs software from source repositories"
arch=('x86_64' 'aarch64' 'i686')
url="https://github.com/amkisko/bmx.rs"
license=('MIT')
depends=('gcc-libs' 'openssl')
makedepends=('cargo' 'git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('')  # updpkgsums

prepare() {
  cd "$srcdir/bmx.rs-$pkgver"
  cargo fetch --locked
}

build() {
  cd "$srcdir/bmx.rs-$pkgver"
  cargo build --release
}

package() {
  cd "$srcdir/bmx.rs-$pkgver"
  install -Dm755 "target/release/bmx" "$pkgdir/usr/bin/bmx"
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
